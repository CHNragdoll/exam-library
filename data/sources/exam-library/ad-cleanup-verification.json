        "block": 2,
        "text": "semaphore seets = 10, // 有10个坐位的资源信号量\nmutex = 1,              // 取号机互斥信号量\nhaveCustom = 0;         // 顾客与营业员同步，无顾客时营业员休息\n\nprocess 顾客\n{\n  P(seets);             // 等空位\n  P(mutex);             // 申请使用取号机\n  从取号机上取号;\n  V(mutex);             // 取号完毕\n  V(haveCustom);        // 通知营业员有新顾客到来\n  等待营业员叫号;\n  V(seets);             // 离开坐位\n  接受服务;\n}\n\nprocess 营业员\n{\n  while(True)\n  {\n    P(haveCustom);      // 没有顾客则休息\n    叫号;\n    为顾客服务;\n  }\n}",
        "decision": "keep: exam question/code/passage content"
